{
  "name": "vanilia-editor",
  "version": "0.2.0",
  "description": "Drop-in rich text editor web component built on Squire",
  "keywords": [
    "custom-element",
    "form-associated",
    "rich-text-editor",
    "squire",
    "web-component",
    "wysiwyg"
  ],
  "homepage": "https://vanilia.peterszarvas.hu",
  "bugs": "https://github.com/peterszarvas94/vanilia/issues",
  "license": "MIT",
  "author": "Peter Szarvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterszarvas94/vanilia.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "module": "./dist/vanilia-editor.js",
  "types": "./dist/vanilia-editor.d.ts",
  "unpkg": "./dist/vanilia-editor.iife.js",
  "jsdelivr": "./dist/vanilia-editor.iife.js",
  "exports": {
    ".": {
      "types": "./dist/vanilia-editor.d.ts",
      "default": "./dist/vanilia-editor.js"
    },
    "./vanilia-editor.css": "./dist/vanilia-editor.css",
    "./vanilia-editor.iife.js": "./dist/vanilia-editor.iife.js"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "build:react-demo": "esbuild scripts/vendor/react.js scripts/vendor/react-dom-client.js --bundle --splitting --format=esm --platform=browser --define:process.env.NODE_ENV='\"production\"' --minify --legal-comments=linked --chunk-names=shared-[hash] --outdir=static/vendor/react && cp node_modules/react/LICENSE static/vendor/react/LICENSE.txt"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "squire-rte": "2.4.11",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  }
}
